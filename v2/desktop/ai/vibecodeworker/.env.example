# ==============================================================================
# 4WEIRD / VIBECODEWORKER ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: You only need A MINIMUM OF 1 API KEY to run VibeCodeWorker!
# Choose whichever provider you prefer. Keys are also saved locally into
# your OS user profile (%APPDATA%/vibecodeworker/credentials.json) so they
# persist consistently across different application builds and updates.
# ==============================================================================

# 1. DEEPSEEK API KEY (DeepSeek Harness / Reasoner R1 / Chat V3 / V4 Flash)
# Sign up at: https://platform.deepseek.com
# Enables native DeepSeek Harness (dsh) self-improvement loops & high token efficiency.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 2. META / MUSE SPARK API KEY (Muse Spark 1.3 Contributor)
# Ultra-low cost multimodal reasoning model by Meta (1M token context, $0.10/M in, $0.20/M out).
# Can be provided via Meta Model API or OpenRouter:
META_API_KEY=your-meta-or-openrouter-api-key-here

# 3. OPENAI API KEY (ChatGPT 5.6 Luna / GPT-5.4 Mini / GPT-4o)
# Flagship general-purpose intelligence and default fast engine.
# Sign up at: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-api-key-here

# 4. OPENROUTER API KEY (Optional multi-model aggregator)
# Access Meta Muse Spark, Gemini 2.5 Pro/Flash, and Claude models under one key.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# 5. GOOGLE GEMINI API KEY (Optional Google Cloud Gemini access)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 6. LOCAL ENDPOINT (Optional - no API key needed for Ollama or LM Studio)
LOCAL_LLM_URL=http://localhost:11434/api/chat

# 6b. OLLAMA LIFECYCLE + PER-ROLE LOCAL MODELS (Optional - all local, no keys)
# VibeCodeWorker auto-starts `ollama serve` when installed (never auto-installs
# without consent). Point at a LAN host to share one Ollama box, or leave the
# default for this machine. OLLAMA_HOST (bind addr) is honored too.
# OLLAMA_URL=http://127.0.0.1:11434
# Each orchestration role can use a different local tag (dashboard panel
# "1B. LOCAL MODELS (OLLAMA)" edits the same values in config/default.json):
# VIBE_ROLE_AGENT=qwen3:8b
# VIBE_ROLE_VISION=qwen2.5vl:7b
# VIBE_ROLE_CODER=qwen2.5-coder:7b
# VIBE_ROLE_REASONER=deepseek-r1:8b

# 7. ELEVENLABS API KEY (Optional BYOK voice layer - TTS/STT/SFX/music)
# Sign up at: https://elevenlabs.io (Dashboard -> Profile -> API Keys)
# Powers: spoken bug alerts, streamer commentary, voice-command playtests,
# NPC/tutorial VO packs, missing-SFX covers, Scribe dialogue QA. The PCM
# audio analyzer (/api/audio/analyze) works fully offline without a key.
# Channel doctrine: mono single-stream default; stereo opt-in adds L/R diff.
ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here

# ==============================================================================
# 7. CLOUD HOSTING (Optional - only needed when exposing the API server)
# Set VIBE_API_TOKEN before putting :42069 on the internet! Mutating /api
# calls must then send it as X-Vibe-Auth header or Bearer token.
# Generate with: openssl rand -hex 24 (min 32 chars recommended).
# Rate limit: 120 req/min per IP. Request timeout: 30s. Body cap: 1MB.
# ==============================================================================
# HOST=127.0.0.1
# PORT=42069
# VIBE_API_TOKEN=generate-with-openssl-rand-hex-24
# NODE_ENV=production
# VIBE_LOG_DIR=/var/log/vibecodeworker
# VIBE_PROVIDER=deepseek
# VIBE_BUDGET_LIMIT=0.05
# VIBE_MAX_INPUT_TOKENS=30000
# VIBE_MAX_OUTPUT_TOKENS=4000
# VIBE_AUDIO_CHANNEL=mono

# ==============================================================================
# 8. OPENCODE.AI BRIDGE (Optional - autonomous direct-code-editing + self-heal)
# Install: curl -fsSL https://opencode.ai/install | bash
#          (Windows: choco install opencode  |  npm install -g opencode-ai)
# ==============================================================================
# OPENCODE_ENABLED=false
# OPENCODE_MODE=cli
# OPENCODE_MODEL=
# OPENCODE_AGENT=build
# OPENCODE_AUTO_APPROVE=true
# OPENCODE_TIMEOUT_MS=600000
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# ==============================================================================
# 9. WEB ENGINE DRIVER (Optional - default: ultralight)
# Ultralight (ultralig.ht) is the main engine. Switch at runtime via the
# dashboard selector, `VIBE_WEB_ENGINE` env, or /api/engine endpoints.
# Valid: ultralight | electron | chromium
# ==============================================================================
# VIBE_WEB_ENGINE=ultralight
