# ==============================================================================
# 4WEIRD / VIBECODEWORKER ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: You only need A MINIMUM OF 1 API KEY to run VibeCodeWorker!
# Choose whichever provider you prefer. Keys are also saved locally into
# your OS user profile (%APPDATA%/vibecodeworker/credentials.json) so they
# persist consistently across different application builds and updates.
# ==============================================================================

# 1. DEEPSEEK API KEY (DeepSeek Harness / Reasoner R1 / Chat V3 / V4 Flash)
# Sign up at: https://platform.deepseek.com
# Enables native DeepSeek Harness (dsh) self-improvement loops & high token efficiency.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 2. META / MUSE SPARK API KEY (Muse Spark 1.3 Contributor)
# Ultra-low cost multimodal reasoning model by Meta (1M token context, $0.10/M in, $0.20/M out).
# Can be provided via Meta Model API or OpenRouter:
META_API_KEY=your-meta-or-openrouter-api-key-here

# 3. OPENAI API KEY (ChatGPT 5.6 Luna / GPT-5.4 Mini / GPT-4o)
# Flagship general-purpose intelligence and default fast engine.
# Sign up at: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-api-key-here

# 4. OPENROUTER API KEY (Optional multi-model aggregator)
# Access Meta Muse Spark, Gemini 2.5 Pro/Flash, and Claude models under one key.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# 5. GOOGLE GEMINI API KEY (Optional Google Cloud Gemini access)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 6. LOCAL ENDPOINT (Optional - no API key needed for Ollama or LM Studio)
LOCAL_LLM_URL=http://localhost:11434/api/chat

# 6b. OLLAMA LIFECYCLE + PER-ROLE LOCAL MODELS (Optional - all local, no keys)
# VibeCodeWorker auto-starts `ollama serve` when installed (never auto-installs
# without consent). Point at a LAN host to share one Ollama box, or leave the
# default for this machine. OLLAMA_HOST (bind addr) is honored too.
# OLLAMA_URL=http://127.0.0.1:11434
# Each orchestration role can use a different local tag (dashboard panel
# "1B. LOCAL MODELS (OLLAMA)" edits the same values in config/default.json):
# VIBE_ROLE_AGENT=qwen3:8b
# VIBE_ROLE_VISION=qwen2.5vl:7b
# VIBE_ROLE_CODER=qwen2.5-coder:7b
# VIBE_ROLE_REASONER=deepseek-r1:8b

# 7. ELEVENLABS API KEY (Optional BYOK voice layer - TTS/STT/SFX/music)
# Sign up at: https://elevenlabs.io (Dashboard -> Profile -> API Keys)
# Powers: spoken bug alerts, streamer commentary, voice-command playtests,
# NPC/tutorial VO packs, missing-SFX covers, Scribe dialogue QA. The PCM
# audio analyzer (/api/audio/analyze) works fully offline without a key.
# Channel doctrine: mono single-stream default; stereo opt-in adds L/R diff.
ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here

# ==============================================================================
# 8. fal.ai API KEY (Optional - cheapest media runs: art, video, voice, 3D)
# Sign up at: https://fal.ai/dashboard/keys
# Powers the desktop FAL KEY drawer (top bar): VERIFY is a free probe ($0),
# CHEAP TEST renders one 512px FLUX schnell image for fractions of a cent.
# Prefer the drawer; it stores the key encrypted outside the app folder so
# rebuilds keep it. This env var is the fallback when nothing is stored.
# FAL_KEY=your-fal-ai-key-here

# ==============================================================================
# 9. 4WEIRD BOT KEY (Optional - act as your bot from the desktop)
# Generate once at: https://4weird.com/bot/setup (bot4weird_ + 20 chars,
# shown once; copy it immediately). The desktop BOT TOKEN drawer stores it
# in a local-only OS app-data file. This env var is the fallback.
# Shown once at issue time — copy it immediately, never commit it.
# FOURWEIRD_BOT_KEY=

# ==============================================================================
# 10. CLOUD HOSTING (Optional - only needed when exposing the API server)
# Set VIBE_API_TOKEN before putting :42069 on the internet! Mutating /api
# calls must then send it as X-Vibe-Auth header or Bearer token.
# Generate with: openssl rand -hex 24 (min 32 chars recommended).
# Rate limit: 120 req/min per IP. Request timeout: 30s. Body cap: 1MB.
# ==============================================================================
# HOST=127.0.0.1
# PORT=42069
# VIBE_API_TOKEN=             (empty = local-only dev; generate with: openssl rand -hex 24, min 32 chars)
# NODE_ENV=production
# VIBE_LOG_DIR=/var/log/vibecodeworker
# VIBE_PROVIDER=deepseek
# VIBE_BUDGET_LIMIT=0.05
# VIBE_MAX_INPUT_TOKENS=30000
# VIBE_MAX_OUTPUT_TOKENS=4000
# VIBE_AUDIO_CHANNEL=mono

# ==============================================================================
# 11. OPENCODE.AI BRIDGE (Optional - autonomous direct-code-editing + self-heal)
# Install the CLI first, then verify with `opencode --version`:
#   macOS / Linux: curl -fsSL https://opencode.ai/install | bash
#   macOS (brew):  brew install opencode
#   Windows:       choco install opencode   |   npm install -g opencode-ai
# Server mode (no CLI cold boot per fix): `opencode serve --port 4096`
#   (docker: `docker compose --profile opencode up` starts the sidecar).
# All values below stay EMPTY (code defaults apply); uncomment + fill locally
# only. Never commit real values. Env overrides config/default.json "opencode".
# ==============================================================================
# OPENCODE_ENABLED=           (default false; set 1/true/yes to enable)
# OPENCODE_MODE=              (cli | server; default cli)
# OPENCODE_BINARY=            (default "opencode" resolved via PATH; absolute-path override)
# OPENCODE_MODEL=             (default: the opencode binary's own default model)
# OPENCODE_AGENT=             (default build)
# OPENCODE_AUTO_APPROVE=      (default true; appends --auto so fixes don't stall)
# OPENCODE_TIMEOUT_MS=        (default 600000 = 10 min per fix run)
# OPENCODE_SERVER_URL=        (server mode only; default http://127.0.0.1:4096)
# OPENCODE_SERVER_USERNAME=   (server mode only; default opencode)
# OPENCODE_SERVER_PASSWORD=   (server mode only; empty = no auth — set locally, never commit)
# OPENCODE_WORKSPACE=         (default: the desktop app dir v2/desktop/code; never repo root/home/fs root)
# OPENCODE_EXPORT_DIR=        (default: <desktop app dir>/data/opencode_exports; Heal/Fix artifacts land here)

# ==============================================================================
# 12. WEB ENGINE DRIVER (Optional - default: ultralight)
# Ultralight (ultralig.ht) is the main engine. Switch at runtime via the
# dashboard selector, `VIBE_WEB_ENGINE` env, or /api/engine endpoints.
# Valid: ultralight | electron | chromium
# ==============================================================================
# VIBE_WEB_ENGINE=ultralight

# ==============================================================================
# 13. UNDOCUMENTED-IN-EXAMPLE VARS ACTUALLY READ BY CODE (names only, no values)
# Added 2026-09-13 audit (DESKTOP-FUTUREPROOF.md N1). All lines below stay
# commented out; uncomment + fill locally only. Never commit real values.
# ==============================================================================
# API port primary override (app/main.js reads VIBECODEWORKER_PORT first,
# then PORT, default 42069; config/default.json "serverPort" is the file
# overlay equivalent):
# VIBECODEWORKER_PORT=42069
# Static game-host port (app/main.js STATIC_PORT, default 8888):
# STATIC_PORT=8888
# MCP/server client base URL override (server/vcw_mcp_server.js VCW_API_URL,
# default http://127.0.0.1:42069):
# VCW_API_URL=http://127.0.0.1:42069
# Web frontend base URL override (VCW_WEB_URL; default derived from server):
# VCW_WEB_URL=http://127.0.0.1:42069
# OpenCode binary override (lib/opencode_bridge.js OPENCODE_BINARY,
# default "opencode"):
# OPENCODE_BINARY=opencode
# OpenRouter model override (lib/openrouter_plays.js OPENROUTER_MODEL):
# OPENROUTER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# RunPod cloud (lib/runpod_cloud.js + lib/storage.js provider "runpod"):
# RUNPOD_API_KEY=rp_your-runpod-key-here
# RUNPOD_API_BASE=https://rest.runpod.io/v1
# VIBE_CLOUD_IMAGE=ghcr.io/mattyjacks/vibecodeworker-cloud:2.0.0
# Open-source games root (lib/open_source_games.js):
# VIBE_OPEN_SOURCE_GAMES_DIR=./data/open-source-games
# Godot runtime (lib/api/godot_routes.js):
# VIBE_GODOT_CLOUD=
# VIBE_GODOT_PROJECT=
# VIBE_GODOT_DISPLAY=:1
# GODOT_INSTALL_ROOT=./data/godot
# 4weird backend base URL (lib/parity/backend_client.js):
# FOURWEIRD_BASE_URL=https://4weird.com
# Local-game auto-fix toggle (automation/local_game_debugger.js):
# AUTO_FIX_BUGS=false
# Trace/replay root (tests/trace_replay.js):
# VIBECODEWORKER_ROOT=.
# Ollama bind host override (lib/ollama_manager.js OLLAMA_HOST; OLLAMA_URL
# already documented in section 6b above):
# OLLAMA_HOST=127.0.0.1:11434
