# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional integrations.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KZ03RW8P96
VCW_SERVICE_URL=
# Primary ad provider (optional). When set, AdSlot tries this URL in an
# iframe first and falls back to the 10 built-in house ads on error, timeout,
# or adblock. When unset, house ads render directly. Guests see them as
# instantly-skippable interstitials; signed-in players pay coins, not ads.
NEXT_PUBLIC_AD_PROVIDER_URL=
# Game AI + Gaming Buddy (OpenAI). Server-only: never add NEXT_PUBLIC_.
# With OPENAI_API_KEY set, buddy chat uses chat-completions (BUDDY_MODEL)
# and voice uses tts-1 / tts-1-hd in all 9 voices (Alloy→Shimmer). Without
# it both fail open with local fallback lines + browser speechSynthesis —
# metering still records every turn with the 25% cut.
OPENAI_API_KEY=
BUDDY_MODEL=gpt-4o-mini
# Clan text moderation (Luna). Server-only: never add NEXT_PUBLIC_.
# Luna is the AI judge behind Valley Net (the clan defense bot). Without it
# Valley Net still runs its structural spam shields and heuristic triage —
# quarantine (pending/hidden) is the safety net either way.
LUNA_MODEL=gpt-5.6-luna
# RunPod (agent rentals + spend mirror). Server-only: never add NEXT_PUBLIC_.
# Set RUNPOD_API_KEY (RunPod console → Settings → API Keys) and the app will:
#  - mark the RunPod provider configured on GET /api/agents/providers,
#  - prove the key live on GET /api/agents/runpod-status (read-only check),
#  - mirror REAL billing (pods + serverless + volumes) into runpod_usage via
#    POST /api/agents/runpod-sync, shown on /my/usage (billed by RunPod, no cut).
# RUNPOD_API_BASE overrides the REST base (default https://api.runpod.io/v2).
RUNPOD_API_KEY=
RUNPOD_API_BASE=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ALLOWED_VARIANTS=
# Coin packs for sale: 500 / 1500 / 5000 / 25000 coins at $0.01 each
# ($5 / $15 / $50 / $250 — 25% service cut included, never added on top).
# There is NO 100-coin pack: 100 coins is the free signup trial.
# List one Shopify variant ID per pack, in pack order:
COIN_PACK_VARIANTS=
# Custom amounts (any whole-coin count, minimum 500) need a $0.01-per-unit
# Shopify variant whose quantity equals the coin count:
COIN_CUSTOM_VARIANT=
NEXT_PUBLIC_SITE_URL=https://4weird.games

# Server-only secrets for the single-deploy API routes (ported from the
# legacy auth-app). Never expose these to the browser: no NEXT_PUBLIC_
# prefix, never import them in client components.
#
# Secret key (sb_secret_... or legacy service_role JWT). Used ONLY for
# Vibe Coins claim/ledger writes and the signup trial credit. Without it,
# /api/coins/claim proxies to the shopify-coins edge function instead and
# no trial credit is issued. Never send it to a browser.
SUPABASE_SERVICE_ROLE_KEY=
#
# Legacy auth-app names (SUPABASE_URL / SUPABASE_ANON_KEY) are still accepted
# as fallbacks by lib/supabase/service.ts; prefer the NEXT_PUBLIC_* names.
#
# New-account trial: 100 Vibe Coins = exactly $1.00 at the buyer price of
# $0.01 per coin. That $1.00 already includes the 25% platform service cut
# ($0.25 cut, $0.75 coin value) — the cut is never added on top.
# Set a long, unique random salt; without it the server intentionally
# declines to issue the credit rather than hash IPs unsafely.
FREE_TRIAL_VCOINS=100
SIGNUP_IP_HASH_SALT=replace-with-a-long-random-secret
