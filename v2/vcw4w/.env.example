# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional integrations.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VCW_SERVICE_URL=
# Primary ad provider (optional). When set, AdSlot tries this URL in an
# iframe first and falls back to the 10 built-in house ads on error, timeout,
# or adblock. When unset, house ads render directly. Guests see them as
# instantly-skippable interstitials; signed-in players pay coins, not ads.
NEXT_PUBLIC_AD_PROVIDER_URL=
# Game AI + Gaming Buddy (OpenAI). Server-only: never add NEXT_PUBLIC_.
# With OPENAI_API_KEY set, buddy chat uses the Responses API (BUDDY_MODEL,
# default gpt-4o-mini) and voice uses tts-1 / tts-1-hd in all 9 voices
# (Nova default). Without it both fail open with local fallback lines +
# browser speechSynthesis; fallbacks are never metered.
# True-cost metering (lib/game-ai.ts): chat tokens + TTS chars + optional
# screen-snapshot image tokens + Supabase DB writes, converted provider-USD
# -> gross Vibe Coins (25% cut INCLUDED) at centicentcoin resolution.
# Override the pinned upstream prices without a code change:
# BUDDY_CHAT_USD_PER_1M_INPUT=0.15
# BUDDY_CHAT_USD_PER_1M_OUTPUT=0.6
# BUDDY_TTS_USD_PER_1M_TTS_1=15
# BUDDY_TTS_USD_PER_1M_TTS_1_HD=30
# BUDDY_DB_USD_PER_LEG=0.00002
OPENAI_API_KEY=
BUDDY_MODEL=gpt-4o-mini
# OpenRouter fallback brains (Gaming Buddy chat, swarm chat, open plays).
# Server-only: never add NEXT_PUBLIC_. Set OPENROUTER_API_KEY (OpenRouter
# dashboard → Keys) to enable the OpenRouter chat brain + live open plays;
# without it those paths use labelled free local fallbacks (never metered).
# OPENROUTER_MODEL pins the model (default
# meta-llama/llama-4-scout-17b-16e-instruct). Placeholder values
# (your-openrouter-api-key-here etc.) are treated as unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Clan text moderation (Luna). Server-only: never add NEXT_PUBLIC_.
# Luna is the AI judge behind Valley Net (the clan defense bot). Without it
# Valley Net still runs its structural spam shields and heuristic triage -
# quarantine (pending/hidden) is reserved for clearly violating text either
# way. NOTE: without a Luna key moderation is lenient medium-bar (ordinary
# posts go visible; only obvious spam shapes are held as pending for human
# review); the UI tells the author when something is awaiting review.
LUNA_MODEL=gpt-5.6-luna
# Clan per-minute upkeep cron (server-only: never add NEXT_PUBLIC_).
# Scheduled cron hits /api/cron/clan-upkeep every minute at :00 and bills every
# clan for elapsed whole minutes (images, DB bytes, bandwidth, Luna AI,
# server share). The route refuses without this secret (Authorization: Bearer
# only - never ?secret=, which leaks into Vercel logs/proxies/history).
# Generate: openssl rand -hex 32. Lazy accrual in the clan page covers reads
# between ticks, so local dev works without setting this.
CRON_SECRET=
# Bot API keys (agent auth). Server-only: never NEXT_PUBLIC_.
# BOT_KEY_PEPPER is REQUIRED: 32+ STRONG-RANDOM chars (256 bits via
# `openssl rand -hex 32`). Human-memorable passwords are REJECTED at issuance
# (503) even at 32+ chars - an AI farm cracks them after any DB leak. Verify
# still accepts >=16 legacy peppers so rotation never locks out old rows.
# Hashes are scrypt(pepper + key, salt=v2$prefix, N=32768); gateway keys use a
# separate vcw-gateway-v2$ domain. Every bot route fails closed without a
# pepper. Also peppers kid_session token hashes (KID_TOKEN_PEPPER optional
# override, else this same value).
# ROTATION (non-breaking): put the NEW value in BOT_KEY_PEPPER, move the OLD
# value to BOT_KEY_PEPPER_PREVIOUS for one rehash window (successful uses
# rehash forward), then clear PREVIOUS. If you already replaced the pepper and
# lost the old value, old keys are dead - users must re-issue on /bot/setup.
BOT_KEY_PEPPER=replace-with-openssl-rand-hex-32-output-64-hex-chars
BOT_KEY_PEPPER_PREVIOUS=
# Optional kid-token pepper override (else BOT_KEY_PEPPER is reused).
KID_TOKEN_PEPPER=
# RunPod (agent rentals + spend mirror). Server-only: never add NEXT_PUBLIC_.
# Set RUNPOD_API_KEY (RunPod console → Settings → API Keys) and the app will:
#  - mark the RunPod provider configured on GET /api/agents/providers,
#  - prove the key live on GET /api/agents/runpod-status (read-only check),
#  - mirror REAL billing (pods + serverless + volumes) into runpod_usage via
#    POST /api/agents/runpod-sync, shown on /my/usage (billed by RunPod, no cut).
# RUNPOD_API_BASE overrides the REST base (default https://api.runpod.io/v2).
RUNPOD_API_KEY=
RUNPOD_API_BASE=
# DigitalOcean provider for agent compute (lib/compute.ts). Server-only.
# Without DIGITALOCEAN_TOKEN the agents marketplace reports the DO provider
# unconfigured and only RunPod provisions; DO listings with a blank endpoint
# cannot auto-provision. Create a token at DigitalOcean → API → Tokens.
DIGITALOCEAN_TOKEN=
# Pod idle lifecycle (optional overrides; defaults 60 / 15 / 24). Server-only.
# POD_IDLE_WARN_MINUTES: no-input minutes before the warning chime (5-240).
# POD_IDLE_STOP_MINUTES: more idle minutes after the warning before STOP (1-120).
# POD_TERMINATE_AFTER_HOURS: untended hours after creation before TERMINATE (1-168).
# POD_IDLE_WARN_MINUTES=
# POD_IDLE_STOP_MINUTES=
# POD_TERMINATE_AFTER_HOURS=
# fal.ai media (30 game-dev + coding tools on /fal). Server-only: never NEXT_PUBLIC_.
# Set FAL_KEY (fal.ai dashboard → Keys; FAL_API_KEY also accepted as an alias)
# and POST /api/fal/generate really queues fal models, metering gross Vibe
# Coins with the 25% cut INCLUDED via meter_fal_usage. Without it the studio
# renders started:false + not-configured, never faked.
# FAL_API_BASE overrides the queue base (default https://queue.fal.run).
FAL_KEY=
FAL_API_BASE=
# Meshy.ai 3D (text/image-to-3D, textures, animation, remesh on /meshy).
# Server-only: never NEXT_PUBLIC_. Set MESHY_API_KEY (Meshy dashboard → API
# Keys) and POST /api/meshy/generate really queues Meshy tasks, metering
# gross Vibe Coins with the 25% cut INCLUDED via meter_meshy_usage. Without
# it the studio renders started:false + not-configured, never faked.
# MESHY_API_BASE overrides the API base (default https://api.meshy.ai).
MESHY_API_KEY=
MESHY_API_BASE=
# Meshy webhook push receiver (POST /api/meshy/webhook). Copy the "Webhook
# Secret" from Meshy dashboard → API settings → Webhooks here so the route
# can reject forgeries; the Payload URL to paste in Meshy is
# https://4weird.com/api/meshy/webhook (local dev: your smee.io proxy URL).
# Empty = reject all deliveries with 503 (fail-closed; Meshy auto-disables
# the webhook after repeated 4xx/5xx, so set this before pasting the URL).
MESHY_WEBHOOK_SECRET=
# Weird Vault + game .zip submissions live in the private `game-blobs`
# Supabase storage bucket (create it in the Supabase dashboard → Storage;
# private, no public policies; all access is via signed URLs that the
# server issues only for clean, unquarantined rows).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ALLOWED_VARIANTS=
# Coin packs for sale: 500 / 1500 / 5000 / 25000 coins at $0.01 each
# ($5 / $15 / $50 / $250 - 25% service cut included, never added on top).
# There is NO 100-coin pack: 100 coins is the free signup trial.
# List one Shopify variant ID per pack, in pack order:
COIN_PACK_VARIANTS=
# Custom amounts (any whole-coin count, minimum 500) need a $0.01-per-unit
# Shopify variant whose quantity equals the coin count:
COIN_CUSTOM_VARIANT=

# Server-only secrets for the single-deploy API routes (ported from the
# legacy auth-app). Never expose these to the browser: no NEXT_PUBLIC_
# prefix, never import them in client components.
#
# Secret key (sb_secret_... or legacy service_role JWT). Used ONLY for
# Vibe Coins claim/ledger writes and the signup trial credit. Without it,
# /api/coins/claim proxies to the shopify-coins edge function instead and
# no trial credit is issued. Never send it to a browser.
SUPABASE_SERVICE_ROLE_KEY=
#
# Legacy auth-app names (SUPABASE_URL / SUPABASE_ANON_KEY) are still accepted
# as fallbacks by lib/supabase/service.ts; prefer the NEXT_PUBLIC_* names.
#
# New-account trial: 100 Vibe Coins = exactly $1.00 at the buyer price of
# $0.01 per coin. That $1.00 already includes the 25% platform service cut
# ($0.25 cut, $0.75 coin value); the cut is never added on top.
# Set a long, unique random salt; without it the server intentionally
# declines to issue the credit rather than hash IPs unsafely.
FREE_TRIAL_VCOINS=100
SIGNUP_IP_HASH_SALT=replace-with-a-long-random-secret
