# ==============================================================================
# MediaMogul & CryptArtistStudio Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your API keys.
# .env is automatically ignored by Git to protect your private credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PEXELS API CONFIGURATION
# ------------------------------------------------------------------------------
# Pexels provides free stock photos and HD/4K videos.
# Direct downloads by URL or ID work without an API key.
# A free API key enables automated keyword searches, curation, and orientation filters.
# Get your free key here: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ------------------------------------------------------------------------------
# 2. OPENAI API CONFIGURATION
# ------------------------------------------------------------------------------
# Powers autonomous video editing, script-to-video generation, live vision analysis,
# voiceover synthesis (TTS), and DALL-E 3 visual generation.
# Get your API key here: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default OpenAI Model for editing decisions (gpt-4o, gpt-4o-mini, o3-mini)
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 3. APPLICATION & PATH OVERRIDES (OPTIONAL)
# ------------------------------------------------------------------------------
# MediaMogul automatically detects Shotcut and FFmpeg on your system.
# Uncomment and customize these paths only if using custom portable installations.
# SHOTCUT_PATH=C:\Program Files\Shotcut\shotcut.exe
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Video resolution and orientation preferences (landscape, portrait)
DEFAULT_ORIENTATION=landscape
DEFAULT_RESOLUTION=1080p
