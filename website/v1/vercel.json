{
  "redirects": [
    {
      "source": "/vcw",
      "destination": "/vibecodeworker",
      "permanent": true
    },
    {
      "source": "/vibecodeworker/preview",
      "destination": "/vibecodeworker/demo/",
      "permanent": true
    },
    {
      "source": "/vibecodeworker/preview/:path*",
      "destination": "/vibecodeworker/demo/:path*",
      "permanent": true
    },
    {
      "source": "/vcw/web/demo",
      "destination": "/vcw/web/demo/",
      "permanent": true
    },
    {
      "source": "/vibecodeworker/docs",
      "destination": "/vibecodeworker/docs/",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/pricing/",
      "permanent": true
    },
    {
      "source": "/html/:path*",
      "destination": "/games/html/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/vcw/web/run",
      "destination": "/vibecodeworker/run.html"
    },
    {
      "source": "/vcw/web/run/",
      "destination": "/vibecodeworker/run.html"
    },
    {
      "source": "/vibecodeworker/run",
      "destination": "/vibecodeworker/run.html"
    },
    {
      "source": "/vcw/web/full",
      "destination": "/vibecodeworker/full.html"
    },
    {
      "source": "/vcw/web/full/",
      "destination": "/vibecodeworker/full.html"
    },
    {
      "source": "/vibecodeworker/full",
      "destination": "/vibecodeworker/full.html"
    },
    {
      "source": "/vcw/web/demo/",
      "destination": "/vibecodeworker/demo/index.html"
    },
    {
      "source": "/vibecodeworker/demo",
      "destination": "/vibecodeworker/demo/index.html"
    },
    {
      "source": "/vibecodeworker/demo/",
      "destination": "/vibecodeworker/demo/index.html"
    },
    {
      "source": "/vibecodeworker",
      "destination": "/vibecodeworker/overview.html"
    },
    {
      "source": "/vibecodeworker/",
      "destination": "/vibecodeworker/overview.html"
    }
  ]
}
