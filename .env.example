# ==============================================================================
# 4WEIRD / VIBECODEWORKER ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: You only need A MINIMUM OF 1 API KEY to run VibeCodeWorker!
# Choose whichever provider you prefer. Keys are also saved locally into
# your OS user profile (%APPDATA%/vibecodeworker/credentials.json) so they
# persist consistently across different application builds and updates.
# ==============================================================================

# 1. DEEPSEEK API KEY (DeepSeek Harness / Reasoner R1 / Chat V3 / V4 Flash)
# Sign up at: https://platform.deepseek.com
# Enables native DeepSeek Harness (dsh) self-improvement loops & high token efficiency.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 2. META / MUSE SPARK API KEY (Muse Spark 1.3 Contributor)
# Ultra-low cost multimodal reasoning model by Meta (1M token context, $0.10/M in, $0.20/M out).
# Can be provided via Meta Model API or OpenRouter:
META_API_KEY=your-meta-or-openrouter-api-key-here

# 3. OPENAI API KEY (ChatGPT 5.6 Luna / GPT-5.4 Mini / GPT-4o)
# Flagship general-purpose intelligence and default fast engine.
# Sign up at: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-api-key-here

# 4. OPENROUTER API KEY (Optional multi-model aggregator)
# Access Meta Muse Spark, Gemini 2.5 Pro/Flash, and Claude models under one key.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# 5. GOOGLE GEMINI API KEY (Optional Google Cloud Gemini access)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 6. LOCAL ENDPOINT (Optional - no API key needed for Ollama or LM Studio)
LOCAL_LLM_URL=http://localhost:11434/api/chat
