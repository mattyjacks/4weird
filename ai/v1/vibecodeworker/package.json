{
  "name": "vibecodeworker-4weird",
  "version": "2.0.0",
  "description": "4WEIRD VIBECODEWORKER - Autonomous Agentic QA Sandbox & Self-Healing Suite Desktop Application",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "start:cloud": "node server/start_api_server.js",
    "heal": "node workers/heal_worker.js",
    "test": "node tests/test_vibecodeworker.js",
    "test:rules": "node tests/test_game_rules.js",
    "test:website": "node tests/test_website_debugger.js",
    "test:ollama": "node tests/test_ollama_models.js",
    "ollama:ensure": "node scripts/node/ensure_ollama.js",
    "test:e2e:whackamole": "node tests/test_aiwhackamole_e2e.js",
    "test:native": "node tests/test_native_hl2.js",
    "test:traces": "node tests/run_trace_tests.js",
    "test:all": "node tests/test_vibecodeworker.js; if ($?) { node tests/test_native_hl2.js }; if ($?) { node tests/run_trace_tests.js }",
    "test:headful": "node tests/test_hub_headful.js",
    "play:hl2": "node scripts/node/run_hl2_playtest.js --window \"Half-Life 2\" --steps 200",
    "play:hl2:dry": "node scripts/node/run_hl2_playtest.js --window \"Half-Life 2\" --steps 5 --dry-run --heuristic",
    "dist": "electron-builder --win portable --dir",
    "build:exe": "electron-builder --win portable",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:mac": "tauri build --target universal-apple-darwin",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu"
  },
  "build": {
    "appId": "com.fourweird.vibecodeworker",
    "productName": "4WEIRD VIBECODEWORKER",
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "vibecodeworker-4weird.exe"
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "scripts/python/input_sim.py"
    ],
    "extraResources": [
      {
        "from": "../../../website/v1",
        "to": "website/v1"
      }
    ],
    "files": [
      "**/*",
      "!dist/*",
      "!scratch/*"
    ]
  },
  "keywords": [
    "tauri",
    "desktop",
    "vibecodeworker",
    "4weird",
    "antigravity"
  ],
  "author": "4WEIRD Team",
  "license": "ISC",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  }
}
