# 4weird-auth environment. Copy to .env (gitignored) and fill in.
# The SECRET key lives here, server-side only. It must never appear in the
# static website, in client JavaScript, or in this example file.

# Supabase project (same project as SUPABASE_SETUP.md).
SUPABASE_URL=https://dwpwzwfdqjguwvtkfaxu.supabase.co
# Publishable key (sb_publishable_... or legacy anon JWT). Used server-side
# to sign users in and to make RLS-enforced reads as the user.
SUPABASE_ANON_KEY=
# Secret key (sb_secret_... or legacy service_role JWT). Used ONLY for
# Vibe Coins claim/ledger writes. Never send it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of THIS service, e.g. https://auth.4weird.com
SITE_URL=https://auth.4weird.com
# Comma-separated origins allowed to call the API with cookies, e.g.
# https://4weird.com,https://www.4weird.com,http://localhost:8888
ALLOWED_ORIGINS=https://4weird.com,https://www.4weird.com

# Cookies: Secure + SameSite=None (cross-site calls from 4weird.com).
# For local http dev set COOKIE_SECURE=false (forces SameSite=Lax).
COOKIE_SECURE=true
COOKIE_SAMESITE=None

# New-account trial: 20 V Coins is approximately $1 at the current 100 for
# $4.99 pack price. Set a long, unique random salt; without it the server
# intentionally declines to issue the credit rather than hash IPs unsafely.
FREE_TRIAL_VCOINS=20
SIGNUP_IP_HASH_SALT=replace-with-a-long-random-secret
