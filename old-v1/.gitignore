# 10. Local VibeCodeWorker runtime artifacts (regenerated at runtime - never commit)
.vibecodeworker-user-data/
**/.vibecodeworker-user-data/
website/v1/ai/vibecodeworker/data/
**/data/autocode_fix_report.json
**/data/bugs_log.json
**/data/live_logs.json
**/data/token_usage.json
**/data/api_debug_report.json
**/data/test_smartlog_*/
test-results/
# Tests redirect APPDATA here so their encrypted local credentials never
# appear as a source change or reach a remote repository.
website/v1/ai/vibecodeworker/.test-appdata/
__pycache__/
*.pyc
*.pyo
credentials.json
**/credentials.json

# 11. MediaMogul local runtime and generated media
# Shotcut is a downloaded, platform-specific editor runtime (~thousands of
# binaries). MediaMogul's install scripts restore it; do not version it.
website/v1/ai/mediamogul/shotcut/
# Downloaded/generated B-roll and local render/session output are machine
# artifacts, not source assets. Keep reusable source graphics outside broll/.
website/v1/ai/mediamogul/broll/
website/v1/ai/mediamogul/exports/
website/v1/ai/mediamogul/recordings/
website/v1/ai/mediamogul/sessions/
website/v1/ai/mediamogul/*_frame.jpg
website/v1/ai/mediamogul/vision_critique_report.md
